# ==========================================
# NS-CIE Production Configuration Reference
# ==========================================

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=nscie_user
POSTGRES_PASSWORD=nscie_password
POSTGRES_DB=nscie_db
DATABASE_URL=postgresql+asyncpg://nscie_user:nscie_password@localhost:5432/nscie_db

# Redis Cache & Background Queue (Redis 7)
REDIS_URL=redis://localhost:6379/0

# NVIDIA NIM / OpenAI Compatible Gateway
# Leave as dummy key for deterministic OFFLINE_HEURISTIC mode, or supply live key for LIVE_NIM
LLM_API_KEY=dummy_key_if_missing
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=nvidia/nemotron-3.5-lightning-30b-a3b

# Frontend Configuration
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
