# Application
ENVIRONMENT=production
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_DB=ns_cie
POSTGRES_USER=ns_cie
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql://ns_cie:change-me-in-local-env@postgres:5432/ns_cie

# Redis
REDIS_URL=redis://redis:6379/0

# NVIDIA NIM / OpenAI-compatible API
LLM_API_KEY=replace-with-real-key
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=replace-with-verified-model-id

# Frontend API URL (browser-visible; use /api behind nginx)
NEXT_PUBLIC_API_BASE_URL=/api
