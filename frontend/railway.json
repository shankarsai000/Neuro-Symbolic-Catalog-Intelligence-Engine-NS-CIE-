{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "frontend/Dockerfile",
    "rootDirectory": "frontend"
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 15,
    "restartPolicyType": "ON_FAILURE"
  }
}